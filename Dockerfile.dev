# Menggunakan image dari 8ct8pus (sudah termasuk Apache + PHP + Xdebug)
FROM 8ct8pus/apache-php-fpm-alpine:1.3.6

# Image ini sudah include:
# - Apache 2.4 + PHP 8.1
# - Xdebug 3.4.1
# - Composer 2.8.5
# - Common PHP extensions

WORKDIR /var/www/html

# Copy aplikasi Anda
COPY . .

# Port Apache
EXPOSE 80